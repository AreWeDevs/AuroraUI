    local subtitle   = config.subtitle or ""
    local width      = config.width   or 520
    local height     = config.height  or 480
    local particles  = config.particles ~= false

    -- ── Root ScreenGui
    local gui = mkInst("ScreenGui", {
        Name            = "ChibuHub",
        DisplayOrder    = 100,
        ResetOnSpawn    = false,
        ZIndexBehavior  = Enum.ZIndexBehavior.Sibling,
        Parent          = CoreGui,
    })
    pcall(function() gui.IgnoreGuiInset = true end)

    -- ── Main frame
    local frame = mkInst("Frame", {
        Name             = "Window",
        Size             = UDim2.new(0, width, 0, height),
        Position         = UDim2.new(0.5, -width/2, 0.5, -height/2),
        BackgroundColor3 = T.WindowBg,
        BorderSizePixel  = 0,
        ClipsDescendants = false,
        ZIndex           = 2,
        Parent           = gui,
    })
    addCorner(frame, 8)
    addStroke(frame, T.ElementBorder, 1, 0.5)

    -- Particle layer (behind everything)
    local particleLayer = mkInst("Frame", {
        Size                  = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants      = true,
        ZIndex                = 1,
        Parent                = frame,
    })
    if particles then startParticles(particleLayer, 20) end

    -- ── Title bar
