-- ────────────────────────────────────────────────────────────
--  Tween helpers
-- ────────────────────────────────────────────────────────────
local function tw(obj, props, t, style, dir)
    local info = TweenInfo.new(t or 0.2,
        Enum.EasingStyle[style or "Quad"],
        Enum.EasingDirection[dir or "Out"])
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

local function twQuick(obj, props)  return tw(obj, props, 0.12) end
local function twMed(obj, props)    return tw(obj, props, 0.25) end
local function twSlow(obj, props)   return tw(obj, props, 0.45, "Quad") end

-- ────────────────────────────────────────────────────────────
--  UI helpers
-- ────────────────────────────────────────────────────────────
local function mkInst(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

local function addCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 4)
    c.Parent = parent
    return c
end

local function addStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or T.ElementBorder
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

local function addPadding(parent, x, y)
    local p = Instance.new("UIPadding")
    p.PaddingLeft   = UDim.new(0, x or 8)
    p.PaddingRight  = UDim.new(0, x or 8)
    p.PaddingTop    = UDim.new(0, y or 4)
    p.PaddingBottom = UDim.new(0, y or 4)
    p.Parent = parent
    return p
end

local function addListLayout(parent, padding, dir, align)
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, padding or 6)
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.HorizontalAlignment = align or Enum.HorizontalAlignment.Left
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = parent
    return l
end

-- Auto-size a frame to its UIListLayout content
local function autosizeY(frame, layout, extra)
    local function update()
        frame.Size = UDim2.new(
            frame.Size.X.Scale, frame.Size.X.Offset,
            0, layout.AbsoluteContentSize.Y + (extra or 0)
        )
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
    update()
end

-- Ripple effect on click
local function addRipple(button, color)
    button.ClipsDescendants = true
    button.MouseButton1Down:Connect(function(mx, my)
        local ripple = mkInst("Frame", {
            Name              = "Ripple",
            Size              = UDim2.new(0, 0, 0, 0),
            Position          = UDim2.new(0,
                mx - button.AbsolutePosition.X,
                0,
                my - button.AbsolutePosition.Y),
            AnchorPoint       = Vector2.new(0.5, 0.5),
            BackgroundColor3  = color or Color3.fromRGB(255,255,255),
            BackgroundTransparency = 0.7,
            ZIndex            = button.ZIndex + 10,
            Parent            = button,
        })
        addCorner(ripple, 999)
        local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.5
        tw(ripple, {
            Size = UDim2.new(0, size, 0, size),
            BackgroundTransparency = 1,
        }, 0.5, "Quad"):Completed:Connect(function()
            ripple:Destroy()
        end)
    end)
end

-- ────────────────────────────────────────────────────────────
--  Particle system
-- ────────────────────────────────────────────────────────────
local function startParticles(parent, count)
    count = count or 18
    local particles = {}

    local function spawnParticle()
        local size = math.random(2, 5)
        local p = mkInst("Frame", {
            Name                  = "Particle",
            Size                  = UDim2.new(0, size, 0, size),
            Position              = UDim2.new(
                math.random(0, 100) / 100, 0,
                1, math.random(-10, 10)
            ),
            BackgroundColor3      = T.ParticleColors[math.random(1, #T.ParticleColors)],
            BackgroundTransparency = math.random(30, 70) / 100,
            ZIndex                = 1,
            Parent                = parent,
        })
        addCorner(p, 999)

        local duration  = math.random(6, 14)
        local targetX   = math.random(0, 100) / 100
        local drift     = (math.random() - 0.5) * 0.3

        tw(p, {
            Position              = UDim2.new(targetX + drift, 0, -0.05, 0),
            BackgroundTransparency = 1,
        }, duration, "Linear"):Completed:Connect(function()
            p:Destroy()
            -- respawn
            task.delay(math.random(1, 3), function()
                if parent and parent.Parent then
                    spawnParticle()
                end
            end)
        end)
        return p
    end

    for i = 1, count do
        task.delay(i * 0.3 + math.random() * 2, function()
            if parent and parent.Parent then
                table.insert(particles, spawnParticle())
            end
        end)
    end

    return particles
end

-- ────────────────────────────────────────────────────────────
--  Notification stack
-- ────────────────────────────────────────────────────────────
local notifStack   = {}
local NOTIF_W      = 280
local NOTIF_H      = 64
local NOTIF_PAD    = 8
local NOTIF_RIGHT  = 14
local NOTIF_TOP    = 14

local function getNotifY(index)
    return NOTIF_TOP + (index - 1) * (NOTIF_H + NOTIF_PAD)
end

local function repositionNotifs(gui)
    for i, n in ipairs(notifStack) do
        twMed(n, { Position = UDim2.new(1, -(NOTIF_W + NOTIF_RIGHT), 0, getNotifY(i)) })
    end
end

local function pushNotif(gui, config)
    local typeColor = ({
        info    = T.NotifInfo,
        success = T.NotifSuccess,
        warn    = T.NotifWarn,
        error   = T.NotifError,
    })[config.type or "info"] or T.NotifInfo

    local notif = mkInst("Frame", {
        Name                  = "Notification",
        Size                  = UDim2.new(0, NOTIF_W, 0, NOTIF_H),
        Position              = UDim2.new(1, NOTIF_RIGHT, 0, getNotifY(#notifStack + 1)),
        BackgroundColor3      = T.NotifBg,
        BackgroundTransparency = 0,
        BorderSizePixel       = 0,
        ClipsDescendants      = true,
        ZIndex                = 20,
        Parent                = gui,
    })
    addCorner(notif, 6)
    addStroke(notif, T.ElementBorder, 1, 0.3)

    -- Accent bar
    mkInst("Frame", {
        Size             = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = typeColor,
        BorderSizePixel  = 0,
        ZIndex           = 21,
        Parent           = notif,
    })

    -- Icon area
    local icon = mkInst("TextLabel", {
        Size                  = UDim2.new(0, 32, 1, 0),
        Position              = UDim2.new(0, 6, 0, 0),
        BackgroundTransparency = 1,
        Text                  = ({
            info    = "ℹ",
            success = "✔",
            warn    = "⚠",
            error   = "✕",
        })[config.type or "info"] or "ℹ",
        TextColor3            = typeColor,
        TextSize              = 18,
        Font                  = T.FontBold,
        ZIndex                = 21,
        Parent                = notif,
    })

    local textX = 44
    mkInst("TextLabel", {
        Size                  = UDim2.new(1, -(textX + 8), 0, 20),
        Position              = UDim2.new(0, textX, 0, 10),
        BackgroundTransparency = 1,
        Text                  = config.title or "Notice",
        TextColor3            = T.TitleText,
        TextSize              = 13,
        Font                  = T.FontBold,
        TextXAlignment        = Enum.TextXAlignment.Left,
        ZIndex                = 21,
        Parent                = notif,
    })

    mkInst("TextLabel", {
        Size                  = UDim2.new(1, -(textX + 8), 0, 20),
        Position              = UDim2.new(0, textX, 0, 30),
        BackgroundTransparency = 1,
        Text                  = config.text or "",
        TextColor3            = T.SubText,
        TextSize              = 11,
        Font                  = T.FontLight,
        TextXAlignment        = Enum.TextXAlignment.Left,
        TextWrapped           = true,
        ZIndex                = 21,
        Parent                = notif,
    })

    -- Progress bar
    local prog = mkInst("Frame", {
        Size             = UDim2.new(1, 0, 0, 2),
        Position         = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = typeColor,
        BorderSizePixel  = 0,
        ZIndex           = 22,
        Parent           = notif,
    })

    -- Slide in
    table.insert(notifStack, notif)
    repositionNotifs(gui)

    local duration = config.duration or 4
    tw(prog, { Size = UDim2.new(0, 0, 0, 2) }, duration, "Linear")

    task.delay(duration, function()
        -- Remove from stack
        for i, n in ipairs(notifStack) do
            if n == notif then
                table.remove(notifStack, i)
                break
            end
        end
        repositionNotifs(gui)
        twMed(notif, { Position = UDim2.new(1, NOTIF_RIGHT, 0, notif.Position.Y.Offset) })
        task.wait(0.3)
        notif:Destroy()
    end)
end

