        -- ── Slider
        function tab:AddSlider(cfg)
            local f = baseElem(52)
            local min = cfg.min or 0
            local max = cfg.max or 100
            local step = cfg.step or 1
            local val = math.clamp(cfg.default or min, min, max)

            local headerRow = mkInst("Frame", {
                Size             = UDim2.new(1, -16, 0, 22),
                Position         = UDim2.new(0, 8, 0, 6),
                BackgroundTransparency = 1,
                ZIndex           = 5,
                Parent           = f,
            })
            local nameLbl = mkInst("TextLabel", {
                Size                  = UDim2.new(0.7, 0, 1, 0),
                BackgroundTransparency = 1,
                Text                  = cfg.text or "Slider",
                TextColor3            = T.TitleText,
                Font                  = T.Font,
                TextSize              = 13,
                TextXAlignment        = Enum.TextXAlignment.Left,
                ZIndex                = 5,
                Parent                = headerRow,
            })
            local valLbl = mkInst("TextLabel", {
                Size                  = UDim2.new(0.3, 0, 1, 0),
                Position              = UDim2.new(0.7, 0, 0, 0),
                BackgroundTransparency = 1,
                Text                  = tostring(val),
                TextColor3            = T.Accent,
                Font                  = T.FontBold,
                TextSize              = 13,
                TextXAlignment        = Enum.TextXAlignment.Right,
                ZIndex                = 5,
                Parent                = headerRow,
            })

            local track = mkInst("Frame", {
                Size             = UDim2.new(1, -16, 0, 5),
                Position         = UDim2.new(0, 8, 0, 36),
                BackgroundColor3 = T.SliderTrack,
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = f,
            })
            addCorner(track, 999)

            local fill = mkInst("Frame", {
                Size             = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = T.SliderFill,
                BorderSizePixel  = 0,
                ZIndex           = 6,
                Parent           = track,
            })
            addCorner(fill, 999)

            local thumb = mkInst("Frame", {
                Size             = UDim2.new(0, 12, 0, 12),
                AnchorPoint      = Vector2.new(0.5, 0.5),
                Position         = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = T.SliderThumb,
                BorderSizePixel  = 0,
                ZIndex           = 7,
                Parent           = track,
            })
            addCorner(thumb, 999)

            local function snapVal(v)
                local snapped = math.floor((v - min) / step + 0.5) * step + min
                return math.clamp(snapped, min, max)
            end

            local function setVal(raw)
                val = snapVal(raw)
                local pct = (val - min) / (max - min)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                thumb.Position = UDim2.new(pct, 0, 0.5, 0)
                valLbl.Text = tostring(val)
                if cfg.callback then cfg.callback(val) end
            end

            setVal(val)

            local sliding = false
            local hitbox = mkInst("TextButton", {
                Size                  = UDim2.new(1, 0, 3, 0),
                Position              = UDim2.new(0, 0, -1, 0),
                BackgroundTransparency = 1,
                Text                  = "",
                ZIndex                = 8,
                Parent                = track,
            })

            hitbox.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    local x = inp.Position.X - track.AbsolutePosition.X
                    setVal(min + math.clamp(x / track.AbsoluteSize.X, 0, 1) * (max - min))
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    local x = inp.Position.X - track.AbsolutePosition.X
                    setVal(min + math.clamp(x / track.AbsoluteSize.X, 0, 1) * (max - min))
                end
            end)

            return f, function() return val end
        end

