                Font                  = T.FontBold,
                TextSize              = 14,
                ZIndex                = 10,
                Parent                = f,
            })

            -- Dropdown list (floats below)
            local listFrame = mkInst("Frame", {
                Size             = UDim2.new(1, 0, 0, 0),
                Position         = UDim2.new(0, 0, 1, 4),
                BackgroundColor3 = T.DropBg,
                BorderSizePixel  = 0,
                ClipsDescendants = true,
                ZIndex           = 20,
                Visible          = false,
                Parent           = f,
            })
            addCorner(listFrame, 5)
            addStroke(listFrame, T.ElementBorder, 1, 0.3)

            local listLayout = addListLayout(listFrame, 2)
            addPadding(listFrame, 4, 4)

            local itemH = 28

            for _, opt in ipairs(options) do
                local item = mkInst("TextButton", {
                    Size             = UDim2.new(1, 0, 0, itemH),
                    BackgroundColor3 = opt == selected and T.DropSelected or T.DropItem,
                    BackgroundTransparency = opt == selected and 0 or 0,
                    Text             = opt,
                    TextColor3       = opt == selected and T.AccentText or T.TitleText,
                    Font             = T.Font,
                    TextSize         = 12,
                    ZIndex           = 21,
                    Parent           = listFrame,
                })
                addCorner(item, 4)

                item.MouseEnter:Connect(function()
                    if opt ~= selected then
                        twQuick(item, {BackgroundColor3 = T.DropItemHover})
                    end
                end)
                item.MouseLeave:Connect(function()
                    if opt ~= selected then
                        twQuick(item, {BackgroundColor3 = T.DropItem})
                    end
                end)
                item.MouseButton1Click:Connect(function()
                    selected = opt
                    selectedLbl.Text = selected
                    -- Reset all items
                    for _, child in pairs(listFrame:GetChildren()) do
                        if child:IsA("TextButton") then
                            twQuick(child, {BackgroundColor3 = T.DropItem, TextColor3 = T.TitleText})
                        end
                    end
                    twQuick(item, {BackgroundColor3 = T.DropSelected, TextColor3 = T.AccentText})
                    -- Close
                    isOpen = false
                    twMed(listFrame, {Size = UDim2.new(1, 0, 0, 0)})
                    task.wait(0.25)
                    listFrame.Visible = false
                    twMed(arrow, {Rotation = 0})
                    if cfg.callback then cfg.callback(selected) end
                end)
            end

            local totalH = #options * (itemH + 2) + 8
            local clickBtn = mkInst("TextButton", {
                Size                  = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text                  = "",
                ZIndex                = 11,
                Parent                = f,
            })
            clickBtn.MouseEnter:Connect(function() twQuick(f, {BackgroundColor3 = T.ElementHover}) end)
            clickBtn.MouseLeave:Connect(function() twQuick(f, {BackgroundColor3 = T.ElementBg}) end)
            clickBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    listFrame.Visible = true
                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                    twMed(listFrame, {Size = UDim2.new(1, 0, 0, totalH)})
                    twMed(arrow, {Rotation = 180})
                else
                    twMed(listFrame, {Size = UDim2.new(1, 0, 0, 0)})
                    task.wait(0.25)
                    listFrame.Visible = false
                    twMed(arrow, {Rotation = 0})
                end
            end)
            return wrapper, function() return selected end
        end

