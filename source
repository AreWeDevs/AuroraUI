        Name             = "TitleBar",
        Size             = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = T.TitleBg,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = frame,
    })
    -- top corners only
    local tbCorner = Instance.new("UICorner")
    tbCorner.CornerRadius = UDim.new(0, 8)
    tbCorner.Parent = titleBar

    -- Mask to square off bottom corners
    mkInst("Frame", {
        Size             = UDim2.new(1, 0, 0, 10),
        Position         = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = T.TitleBg,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = titleBar,
    })

    -- Divider line at bottom of title bar
    mkInst("Frame", {
        Size             = UDim2.new(1, 0, 0, 1),
        Position         = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = T.ElementBorder,
        BorderSizePixel  = 0,
        ZIndex           = 6,
        Parent           = titleBar,
    })

    -- Title text (bold part)
    local titleBold = mkInst("TextLabel", {
        Size                  = UDim2.new(0, 200, 1, 0),
        Position              = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text                  = title,
        TextColor3            = T.Accent,
        TextXAlignment        = Enum.TextXAlignment.Left,
        Font                  = T.FontBold,
        TextSize              = 14,
        ZIndex                = 6,
        Parent                = titleBar,
    })

    if subtitle ~= "" then
        local sep = mkInst("TextLabel", {
            Size                  = UDim2.new(0, 14, 1, 0),
            Position              = UDim2.new(0, 14 + titleBold.TextBounds.X, 0, 0),
            BackgroundTransparency = 1,
            Text                  = " : ",
            TextColor3            = T.SubText,
            TextXAlignment        = Enum.TextXAlignment.Left,
            Font                  = T.FontLight,
            TextSize              = 14,
            ZIndex                = 6,
            Parent                = titleBar,
        })
        mkInst("TextLabel", {
            Size                  = UDim2.new(0, 200, 1, 0),
            Position              = UDim2.new(0, 14 + 80 + 14, 0, 0),
            BackgroundTransparency = 1,
            Text                  = subtitle,
            TextColor3            = T.TitleText,
            TextXAlignment        = Enum.TextXAlignment.Left,
            Font                  = T.FontLight,
            TextSize              = 14,
            ZIndex                = 6,
            Parent                = titleBar,
        })
    end

    -- Version badge (top right, before buttons)
    local versionLabel
    if config.version then
        local vBadge = mkInst("Frame", {
            Size             = UDim2.new(0, 0, 0, 22),
            Position         = UDim2.new(1, -80, 0.5, -11),
            BackgroundColor3 = T.ElementBg,
            AutomaticSize    = Enum.AutomaticSize.X,
            ZIndex           = 6,
            Parent           = titleBar,
        })
        addCorner(vBadge, 4)
        addPadding(vBadge, 8, 0)
        mkInst("TextLabel", {
            Size                  = UDim2.new(0, 0, 1, 0),
            AutomaticSize         = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                  = "v" .. config.version,
            TextColor3            = T.SubText,
            Font                  = T.FontMono,
            TextSize              = 11,
            ZIndex                = 7,
            Parent                = vBadge,
        })
    end

    -- Minimize button
    local minBtn = mkInst("TextButton", {
        Size                  = UDim2.new(0, 28, 0, 28),
        Position              = UDim2.new(1, -62, 0.5, -14),
        BackgroundColor3      = T.ElementBg,
        BackgroundTransparency = 0,
        Text                  = "─",
        TextColor3            = T.SubText,
        Font                  = T.FontBold,
        TextSize              = 12,
        ZIndex                = 7,
        Parent                = titleBar,
    })
    addCorner(minBtn, 4)

    -- Close button
    local closeBtn = mkInst("TextButton", {
        Size                  = UDim2.new(0, 28, 0, 28),
        Position              = UDim2.new(1, -30, 0.5, -14),
        BackgroundColor3      = Color3.fromRGB(180, 50, 50),
        BackgroundTransparency = 0.3,
        Text                  = "✕",
        TextColor3            = Color3.fromRGB(255, 255, 255),
        Font                  = T.FontBold,
        TextSize              = 12,
        ZIndex                = 7,
        Parent                = titleBar,
    })
    addCorner(closeBtn, 4)

    -- Hover effects on buttons
    closeBtn.MouseEnter:Connect(function() twQuick(closeBtn, {BackgroundTransparency = 0}) end)
    closeBtn.MouseLeave:Connect(function() twQuick(closeBtn, {BackgroundTransparency = 0.3}) end)
    minBtn.MouseEnter:Connect(function() twQuick(minBtn, {BackgroundColor3 = T.ElementHover}) end)
    minBtn.MouseLeave:Connect(function() twQuick(minBtn, {BackgroundColor3 = T.ElementBg}) end)

    closeBtn.MouseButton1Click:Connect(function()
        twSlow(frame, {Size = UDim2.new(0, width, 0, 0), BackgroundTransparency = 1})
        task.wait(0.45)
        gui:Destroy()
    end)

    local minimized   = false
    local bodyHeight  = height - 44
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            twMed(frame, {Size = UDim2.new(0, width, 0, 44)})
        else
            twMed(frame, {Size = UDim2.new(0, width, 0, height)})
        end
    end)

    -- ── Dragging
    local dragging, dragStart, startPos = false, nil, nil
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)
    titleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)

    -- ── Tab bar
    local tabBar = mkInst("Frame", {
        Name             = "TabBar",
        Size             = UDim2.new(1, 0, 0, 36),
        Position         = UDim2.new(0, 0, 0, 44),
        BackgroundColor3 = T.TitleBg,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = frame,
    })
    mkInst("Frame", {
        Size             = UDim2.new(1, 0, 0, 1),
        Position         = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = T.ElementBorder,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = tabBar,
    })
    local tabBarLayout = addListLayout(tabBar, 0, Enum.FillDirection.Horizontal)
    tabBarLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    addPadding(tabBar, 6, 0)

    -- ── Content area
    local contentHolder = mkInst("Frame", {
        Name             = "ContentHolder",
        Size             = UDim2.new(1, 0, 1, -80),
        Position         = UDim2.new(0, 0, 0, 80),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex           = 3,
        Parent           = frame,
    })

    -- Entrance animation
    frame.Size = UDim2.new(0, width, 0, 0)
    frame.BackgroundTransparency = 1
    task.defer(function()
        twMed(frame, {
            Size = UDim2.new(0, width, 0, height),
            BackgroundTransparency = 0,
        })
    end)

    -- ─────────────────────────────────────────────────────────
    --  Window object
    -- ─────────────────────────────────────────────────────────
    local window = {
        _gui          = gui,
        _frame        = frame,
        _contentHolder = contentHolder,
        _tabs         = {},
        _currentTab   = nil,
        _currentBtn   = nil,
        _notifCount   = 0,
    }

    -- ── Notification
    function window:Notify(cfg)
        pushNotif(gui, cfg)
    end

    -- ── Add Tab
    function window:AddTab(name, icon)
        local tabContent = mkInst("ScrollingFrame", {
            Name                  = "Tab_" .. name,
            Size                  = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel       = 0,
            ScrollBarThickness    = 3,
            ScrollBarImageColor3  = T.Accent,
            CanvasSize            = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize   = Enum.AutomaticSize.Y,
            Visible               = false,
            ZIndex                = 3,
            Parent                = contentHolder,
        })
        addPadding(tabContent, 10, 8)
        local contentLayout = addListLayout(tabContent, 6)
        contentLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

        -- Tab button
        local labelText = (icon and (icon .. "  ") or "") .. name
        local tabBtn = mkInst("TextButton", {
            Size                  = UDim2.new(0, 0, 1, 0),
            AutomaticSize         = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                  = "",
            ZIndex                = 6,
            Parent                = tabBar,
        })
        addPadding(tabBtn, 12, 0)

        local tabBtnLabel = mkInst("TextLabel", {
            Size                  = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text                  = labelText,
