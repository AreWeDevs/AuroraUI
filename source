                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = f,
            })
            addCorner(swatch, 4)
            addStroke(swatch, T.ElementBorder, 1, 0)

            -- Hue gradient bar
            local hueBar = mkInst("Frame", {
                Size             = UDim2.new(1, -16, 0, 10),
                Position         = UDim2.new(0, 8, 0, 34),
                BackgroundColor3 = Color3.fromRGB(255,255,255),
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = f,
            })
            addCorner(hueBar, 4)

            local hueGrad = Instance.new("UIGradient")
            hueGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0/6, Color3.fromHSV(0/6, 1, 1)),
                ColorSequenceKeypoint.new(1/6, Color3.fromHSV(1/6, 1, 1)),
                ColorSequenceKeypoint.new(2/6, Color3.fromHSV(2/6, 1, 1)),
                ColorSequenceKeypoint.new(3/6, Color3.fromHSV(3/6, 1, 1)),
                ColorSequenceKeypoint.new(4/6, Color3.fromHSV(4/6, 1, 1)),
                ColorSequenceKeypoint.new(5/6, Color3.fromHSV(5/6, 1, 1)),
                ColorSequenceKeypoint.new(1,   Color3.fromHSV(1,   1, 1)),
            })
            hueGrad.Parent = hueBar

            local hueThumb = mkInst("Frame", {
                Size             = UDim2.new(0, 8, 1, 4),
                Position         = UDim2.new(hue, -4, 0, -2),
                BackgroundColor3 = Color3.fromRGB(255,255,255),
                BorderSizePixel  = 0,
                ZIndex           = 7,
                Parent           = hueBar,
            })
            addCorner(hueThumb, 2)
            addStroke(hueThumb, Color3.fromRGB(0,0,0), 1, 0.4)

            local function updateColor()
                current = Color3.fromHSV(hue, sat, val2)
                twQuick(swatch, {BackgroundColor3 = current})
                hueThumb.Position = UDim2.new(hue, -4, 0, -2)
                if cfg.callback then cfg.callback(current) end
            end

            local sliding = false
            local hHitbox = mkInst("TextButton", {
                Size                  = UDim2.new(1, 0, 3, 0),
                Position              = UDim2.new(0, 0, -1, 0),
                BackgroundTransparency = 1,
                Text                  = "",
                ZIndex                = 8,
                Parent                = hueBar,
            })
            hHitbox.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    local x = inp.Position.X - hueBar.AbsolutePosition.X
                    hue = math.clamp(x / hueBar.AbsoluteSize.X, 0, 1)
                    updateColor()
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    local x = inp.Position.X - hueBar.AbsolutePosition.X
                    hue = math.clamp(x / hueBar.AbsoluteSize.X, 0, 1)
                    updateColor()
                end
            end)

            -- Sat/Val selector strip (brightness)
            local satValRow = mkInst("Frame", {
                Size             = UDim2.new(1, -16, 0, 10),
                Position         = UDim2.new(0, 8, 0, 50),
                BackgroundColor3 = Color3.fromRGB(255,255,255),
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = f,
            })
            addCorner(satValRow, 4)

            local satGrad = Instance.new("UIGradient")
            satGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
            })
            satGrad.Parent = satValRow

            -- Just a brightness/sat quick selector
            local valHitbox = mkInst("TextButton", {
                Size                  = UDim2.new(1, 0, 3, 0),
                Position              = UDim2.new(0, 0, -1, 0),
                BackgroundTransparency = 1,
                Text                  = "",
                ZIndex                = 8,
                Parent                = satValRow,
            })
            local slidingV = false
            valHitbox.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    slidingV = true
                    local x = inp.Position.X - satValRow.AbsolutePosition.X
                    val2 = math.clamp(x / satValRow.AbsoluteSize.X, 0, 1)
                    updateColor()
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then slidingV = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if slidingV and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    local x = inp.Position.X - satValRow.AbsolutePosition.X
                    val2 = math.clamp(x / satValRow.AbsoluteSize.X, 0, 1)
                    updateColor()
                end
            end)

            f.Size = UDim2.new(1, 0, 0, 68)
            return f, function() return current end
        end

        -- ── Section
        function tab:AddSection(sectionTitle)
            local sectionFrame = mkInst("Frame", {
                Size             = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1,
                AutomaticSize    = Enum.AutomaticSize.Y,
                ZIndex           = 4,
                Parent           = tabContent,
            })

            local header = mkInst("Frame", {
                Size             = UDim2.new(1, 0, 0, 26),
                BackgroundTransparency = 1,
                ZIndex           = 4,
                Parent           = sectionFrame,
            })

            local chevron = mkInst("TextLabel", {
                Size                  = UDim2.new(0, 16, 1, 0),
                Position              = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
                Text                  = "▾",
                TextColor3            = T.Accent,
                Font                  = T.FontBold,
                TextSize              = 12,
                ZIndex                = 5,
                Parent                = header,
            })

            mkInst("TextLabel", {
                Size                  = UDim2.new(1, -16, 1, 0),
                Position              = UDim2.new(0, 18, 0, 0),
                BackgroundTransparency = 1,
                Text                  = sectionTitle or "Section",
                TextColor3            = T.Accent,
                Font                  = T.FontBold,
                TextSize              = 12,
                TextXAlignment        = Enum.TextXAlignment.Left,
                ZIndex                = 5,
                Parent                = header,
            })

            mkInst("Frame", {
                Size             = UDim2.new(1, -18, 0, 1),
                Position         = UDim2.new(0, 18, 1, -2),
                BackgroundColor3 = T.ElementBorder,
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = header,
            })

            local contentFrame = mkInst("Frame", {
                Size             = UDim2.new(1, 0, 0, 0),
                Position         = UDim2.new(0, 0, 0, 28),
                BackgroundTransparency = 1,
                AutomaticSize    = Enum.AutomaticSize.Y,
                ZIndex           = 4,
                Parent           = sectionFrame,
                ClipsDescendants = false,
            })
            addListLayout(contentFrame, 6)

            local collapsed = false
            local headerBtn = mkInst("TextButton", {
                Size                  = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text                  = "",
                ZIndex                = 6,
                Parent                = header,
            })
            headerBtn.MouseButton1Click:Connect(function()
                collapsed = not collapsed
                contentFrame.Visible = not collapsed
                twQuick(chevron, {Rotation = collapsed and -90 or 0})
            end)

            -- Section element API (mirrors tab methods but parents to contentFrame)
            local section = {}

            local function makeSectionMethod(methodName)
                section[methodName] = function(self, cfg)
                    -- Temporarily redirect parent
                    local orig = tabContent
                    tabContent = contentFrame
                    local result = tab[methodName](tab, cfg)
                    tabContent = orig
                    return result
                end
            end

            -- Proxy all element methods into section
            for _, m in ipairs({
                "AddButton","AddSlider","AddToggle","AddKeybind",
                "AddDropdown","AddTextInput","AddProgressBar",
                "AddColorPicker","AddLabel","AddSeparator"
            }) do
                section[m] = function(self, cfg)
                    -- Temporarily swap parent
                    local realTabContent = tabContent
                    tabContent = contentFrame
                    local res = tab[m](tab, cfg)
                    tabContent = realTabContent
                    return res
                end
            end

            return section
        end

        -- ── Two-column layout helper
        function tab:CreateColumns(leftWidth, rightWidth)
            leftWidth  = leftWidth  or 0.49
            rightWidth = rightWidth or 0.49

            local container = mkInst("Frame", {
                Size             = UDim2.new(1, 0, 0, 0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ZIndex           = 4,
                Parent           = tabContent,
            })

            local leftCol = mkInst("Frame", {
                Size             = UDim2.new(leftWidth, -3, 0, 0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ZIndex           = 4,
                Parent           = container,
            })
            addListLayout(leftCol, 6)

            local rightCol = mkInst("Frame", {
                Size             = UDim2.new(rightWidth, -3, 0, 0),
                Position         = UDim2.new(1 - rightWidth, 3, 0, 0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ZIndex           = 4,
                Parent           = container,
            })
            addListLayout(rightCol, 6)

            -- Wrap left/right in col objects with same API
            local function makeCol(frame)
                local col = {}
                for _, m in ipairs({
                    "AddButton","AddSlider","AddToggle","AddKeybind",
                    "AddDropdown","AddTextInput","AddProgressBar",
                    "AddColorPicker","AddLabel","AddSeparator"
                }) do
                    col[m] = function(self, cfg)
                        local realTabContent = tabContent
                        tabContent = frame
                        local res = tab[m](tab, cfg)
                        tabContent = realTabContent
                        return res
                    end
                end
                return col
            end

            return makeCol(leftCol), makeCol(rightCol)
        end

        return tab
    end -- AddTab

    return window
end -- CreateWindow

return ChibuHub
